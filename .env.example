# 复制为 .env 后按需修改（docker compose 会自动读取）
# MySQL（容器间连接串由 compose 用下面三项自动拼装，无需手写 DATABASE_URL）
MYSQL_DATABASE=wrongbook
MYSQL_USER=wrongbook
MYSQL_PASSWORD=wrongbook
MYSQL_ROOT_PASSWORD=rootpass

# 可选：设置后所有写接口（POST/PUT/DELETE）必须带请求头 X-API-Key，
# 同时给前端构建/运行时设置同名变量 VITE_API_KEY 才会自动携带；单机自用可留空
API_KEY=

# 可选：AI 服务商密钥（配了后端环境变量，前端页面就不用每次填；不配也能在页面临时填写）
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
